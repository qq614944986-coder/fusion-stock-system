<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>双引擎选股择时仪表盘 {{ date }}</title>
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<style>
  :root { --bg:#0d1117; --card:#161b22; --border:#30363d; --text:#c9d1d9; --dim:#8b949e;
          --up:#f85149; --down:#3fb950; --accent:#58a6ff; --warn:#d29922; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { background:var(--bg); color:var(--text); font-family:"Microsoft YaHei",sans-serif; padding:16px; }
  h1 { font-size:20px; margin-bottom:4px; }
  .sub { color:var(--dim); font-size:12px; margin-bottom:14px; }
  .zone-badge { display:inline-block; padding:3px 12px; border-radius:12px; font-weight:bold; margin-left:8px; }
  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .card { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:14px; margin-bottom:14px; }
  .card h2 { font-size:15px; margin-bottom:10px; color:var(--accent); border-left:3px solid var(--accent); padding-left:8px; }
  .chart { width:100%; height:300px; }
  .chart-sm { width:100%; height:240px; }
  table { width:100%; border-collapse:collapse; font-size:12px; }
  th, td { padding:5px 7px; border-bottom:1px solid var(--border); text-align:left; white-space:nowrap; }
  th { color:var(--dim); font-weight:normal; background:#1c2129; position:sticky; top:0; }
  tr:hover td { background:#1c2129; }
  .tbl-wrap { max-height:420px; overflow:auto; }
  .tag { display:inline-block; padding:1px 7px; border-radius:9px; font-size:11px; margin:1px; }
  .tag-attack { background:#8b2f2f; } .tag-defend { background:#2f5d8b; }
  .tag-risk { background:#6e4b0e; } .tag-ok { background:#1e4d2b; }
  .tag-s { background:#8b2f2f; color:#ffd5d5; font-weight:bold; }
  .num-up { color:var(--up); } .num-down { color:var(--down); }
  pre.advice { white-space:pre-wrap; font-family:inherit; font-size:12px; background:#0d1117;
               border:1px solid var(--border); border-radius:6px; padding:10px; line-height:1.7; }
  .pos-head { display:flex; flex-wrap:wrap; gap:10px; font-size:13px; margin-bottom:8px; align-items:center; }
  .state-pill { padding:2px 10px; border-radius:10px; font-weight:bold; }
  .st-EMPTY{background:#333}.st-BUILDING{background:#1f6feb44}.st-HOLDING{background:#2ea04366}
  .st-REDUCING{background:#d2992266}.st-EXITED{background:#f8514966}
  .sig-BP{color:#3fb950;font-weight:bold}.sig-SP{color:#f85149;font-weight:bold}
  .risk-item { padding:4px 0 4px 14px; border-left:2px solid var(--warn); margin:6px 0; font-size:12px; }
  .factor-note { color:var(--dim); font-size:11px; }
  .footer { color:var(--dim); font-size:11px; text-align:center; margin-top:10px; line-height:1.6; }
  .p0{color:#f85149;font-weight:bold}.p1{color:#d29922;font-weight:bold}.p2{color:#58a6ff}
  /* ⓪ 总结决策 */
  .summary-card { background:linear-gradient(135deg,#161b22 60%,#1a2332); border:1px solid #3b82f6; }
  .summary-card h2 { color:#7ee787; border-left-color:#7ee787; font-size:16px; }
  .summary-line { font-size:14px; line-height:2.1; padding:2px 0; border-bottom:1px dashed #21262d; }
  .summary-line:last-child { border-bottom:none; }
  /* ① 宏观 */
  .idx-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:8px; margin-bottom:10px; }
  .idx-cell { background:#0d1117; border:1px solid var(--border); border-radius:6px; padding:8px 10px; }
  .idx-cell .nm { font-size:12px; color:var(--dim); }
  .idx-cell .px { font-size:16px; font-weight:bold; margin:2px 0; }
  .idx-cell .amt { font-size:11px; color:var(--dim); }
  .macro-strip { font-size:13px; line-height:1.9; }
  /* ② 情绪实时指标 */
  .rt-strip { display:flex; flex-wrap:wrap; gap:10px; margin:8px 0; }
  .rt-item { background:#0d1117; border:1px solid var(--border); border-radius:6px; padding:6px 12px; font-size:12px; }
  .rt-item b { font-size:15px; }
  /* ④ 三线总揽 */
  .pool-h { font-size:13px; margin:12px 0 6px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .pool-stat { font-size:11px; color:var(--dim); background:#0d1117; border:1px solid var(--border);
               border-radius:9px; padding:1px 8px; }
  /* ⑤ 复盘 */
  .rv-block { margin-bottom:14px; }
  .rv-stats { font-size:12px; line-height:1.9; background:#0d1117; border:1px solid var(--border);
              border-radius:6px; padding:8px 12px; margin-bottom:6px; }
  .rv-h { font-size:12px; color:var(--dim); margin:8px 0 4px; }
  /* ⑥ 打板纪律 */
  .dis-line { padding:4px 0 4px 14px; border-left:2px solid var(--warn); margin:6px 0; font-size:12px; }
  /* 决策流水线 */
  .chain { font-size:11px; color:var(--dim); font-weight:normal; }
  .chain-bar { font-size:12px; color:var(--accent); background:#0d1117; border:1px dashed var(--border);
               border-radius:6px; padding:9px 14px; margin-bottom:14px; line-height:1.8; }
  .op-line { font-size:13px; line-height:2.0; padding:3px 0; border-bottom:1px dashed #21262d; }
  .op-line:last-child { border-bottom:none; }
  .op-line b { color:#7ee787; }
  .op-head { font-weight:bold; color:var(--accent); margin:6px 0 2px; }
  .pl { font-size:11px; color:var(--dim); }
</style>
</head>
<body>
<h1>双引擎选股择时仪表盘 <span class="zone-badge" id="zoneBadge"></span></h1>
<div class="sub" id="subLine"></div>

<!-- ① 总结决策与操作清单（使用者第一眼） -->
<div class="card summary-card"><h2>⓪ 总结决策 <span class="chain">先看这里，再下判断</span></h2><div id="summary"></div></div>
<div class="chain-bar">决策流水线：②宏观 → ③情绪 → ④板块埋伏 → ⑤候选池 → ⑥⑦观察复盘 → ⑧打板 → ⑨三池精选</div>

<!-- ② 宏观大盘 -->
<div class="card"><h2>① 宏观大盘 <span class="chain">↳ 指数强弱/量能 → 定今日基调</span></h2>
  <div class="idx-grid" id="idxGrid"></div>
  <div class="macro-strip" id="macroStrip"></div></div>

<!-- ③ 情绪周期 -->
<div class="grid2">
  <div class="card"><h2>② 情绪周期走势（近30日） <span class="chain">↳ 温度/区间 → 定仓位上限</span></h2><div id="sentLine" class="chart"></div></div>
  <div class="card"><h2>情绪温度表盘</h2><div id="gauge" class="chart"></div></div>
</div>
<div class="card"><h2>市场情绪指标（收盘终值）</h2>
  <div class="rt-strip" id="sentRt"></div>
  <div class="grid2"><div id="radar" class="chart-sm"></div><div id="zoneInfo" style="font-size:12px;line-height:1.8;align-self:center"></div></div>
</div>

<!-- ④ 板块埋伏建议 + 轮动榜 -->
<div class="card"><h2>③ 板块埋伏建议 <span class="chain">↳ 情绪区间 → 定进攻/防守板块</span></h2><div id="ambush"></div></div>
<div class="card"><h2>板块轮动榜（六维度 + 广度/领涨/主力流入）</h2>
  <div class="tbl-wrap"><table id="sectorTbl"></table></div></div>

<!-- ⑤ 短中长线评分总揽 -->
<div class="card"><h2>④ 短中长线评分总揽 <span class="chain">↳ 门槛板块 → 候选宇宙 → 评分+次日概率</span></h2><div id="pools"></div></div>

<!-- ④.5 双轨机会卡片 -->
<div class="card"><h2>④ 双轨机会卡片 <span class="chain">↳ 左轨预期差低吸 + 右轨主升跟随（老樊执行）</span></h2><div id="oppCards"></div></div>

<!-- ⑥ 短线观察池复盘 -->
<div class="card"><h2>⑤ 短线观察池复盘 <span class="chain">↳ 短线候选 → 次日验证 → 去弱留强(破5日线删)</span></h2><div id="poolReview"></div></div>

<!-- ⑦ 中长线观察池复盘 -->
<div class="card"><h2>⑥ 中长线观察池复盘 <span class="chain">↳ 中线破MA20/评分&lt;60删 · 长线破中期带下沿删</span></h2><div id="poolReview2"></div></div>

<!-- ⑧ 打板筛选 -->
<div class="card"><h2>⑦ 打板筛选 <span class="chain">↳ 主板·首半·三板·封板·量能·主力净额·板块共振</span></h2>
  <div id="limitupDiscipline"></div><div id="limitup"></div></div>

<!-- ⑨ 三池交叉验证精选 -->
<div class="card"><h2>⑧ 三池Top3交叉验证精选 <span class="chain">↳ 多源命中≥2 → 交叉优先</span></h2><div id="jxTop"></div></div>

<!-- ⑩ 持仓监控 + ⑪ 信号日历 -->
<div class="card"><h2>⑨ 持仓监控（老樊状态机 + 均线带 + 条件化建议）</h2><div id="positions"></div></div>
<div class="card"><h2>⑩ 信号日历（近20日 BP/SP 触发点）</h2>
  <div class="tbl-wrap"><table id="sigTbl"></table></div></div>

<!-- ⑫ 风险提示 -->
<div class="card"><h2>⑪ 风险提示</h2><div id="risks"></div></div>

<div class="footer">本工具为信号提示辅助，不构成投资建议，最终决策需人工确认。<br>
生成时间 {{ generated_at }}</div>

<script>
const D = {{ data_json }};
const ZONE_COLORS = {"冰点区":"#58a6ff","退潮区":"#8957e5","震荡区":"#d29922","偏强区":"#3fb950","高热区":"#f85149"};
const esc = s => String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
const pct = v => v==null?"—":(v>0?"+":"")+Number(v).toFixed(2)+"%";
const pctCls = v => v==null?"":(v>0?"num-up":v<0?"num-down":"");
const num = v => v==null?"—":Number(v).toFixed(2);
const num1 = v => v==null?"—":Number(v).toFixed(1);

// ---------- 头部
(function(){
  const z = D.sentiment.zone;
  const b = document.getElementById("zoneBadge");
  b.textContent = z.name+" "+D.sentiment.temperature+"分 · "+z.label;
  b.style.background = (ZONE_COLORS[z.name]||"#333")+"33";
  b.style.color = ZONE_COLORS[z.name]||"#ccc";
  document.getElementById("subLine").textContent =
    `总仓位上限 ≤${z.max_total}% · 单票上限 ≤${z.max_single}% · 持仓数 ≤${z.max_count}只 · 纪律：${z.rule}`;
})();

// ---------- ⓪ 总结决策与操作建议
(function(){
  const lines = D.summary||[];
  let h = ""; let inOps = false;
  lines.forEach(l=>{
    if(l.indexOf("——")===0){ inOps=true; h += `<div class="op-head">${esc(l)}</div>`; return; }
    if(inOps){ h += `<div class="op-line">${esc(l)}</div>`; return; }
    h += `<div class="summary-line">${esc(l)}</div>`;
  });
  document.getElementById("summary").innerHTML = h || "<div class='factor-note'>（无）</div>";
})();

// ---------- ① 宏观大盘
(function(){
  const M = D.macro||{indices:[],global_indices:[]};
  document.getElementById("idxGrid").innerHTML = (M.indices||[]).map(i=>
    `<div class="idx-cell"><div class="nm">${esc(i.name)}${["创业板指","科创50"].includes(i.name)?'<span class="pl">·双创</span>':""}</div>
      <div class="px ${pctCls(i.pct_chg)}">${i.close??"—"} <span style="font-size:12px">${pct(i.pct_chg)}</span></div>
      <div class="amt">${i.amount_yi==null?"":"成交额 "+i.amount_yi+"亿"}</div></div>`).join("");
  const gi = (M.global_indices||[]).map(g=>
    `<span class="rt-item">外围 ${esc(g.name)} <b class="${pctCls(g.pct_chg)}">${pct(g.pct_chg)}</b></span>`).join("");
  const dlt = M.turnover_delta_prev;
  const S = M.turnover_series||[];
  let volHtml = `<span class="rt-item">量能较前日 <b class="${dlt==null?"":(dlt>0?"num-up":"num-down")}">${dlt==null?"—":(dlt>0?"放量+":"缩量")+Math.abs(dlt)+"%"}</b></span>` +
    `<span class="rt-item">较5日均 <b class="${pctCls((M.turnover_ratio_5d||1)-1)}">${M.turnover_ratio_5d==null?"—":"×"+M.turnover_ratio_5d}</b></span>`;
  if(M.turnover_trend) volHtml += `<span class="rt-item" style="color:var(--dim)">${esc(M.turnover_trend)}</span>`;
  let chartHtml = "";
  if(S.length>=2){
    chartHtml = `<div id="volChart" style="width:100%;height:150px;margin-top:6px"></div>`;
  }
  document.getElementById("macroStrip").innerHTML =
    `<span class="rt-item">两市成交额 <b>${M.turnover_yi==null?"—[数据缺失]":M.turnover_yi+"亿"}</b></span>` + volHtml + gi + chartHtml +
    `<div style="margin-top:6px" class="factor-note">${esc(M.summary||"")}</div>`;
  if(S.length>=2){
    const c = echarts.init(document.getElementById("volChart"));
    c.setOption({
      grid:{left:52,right:10,top:18,bottom:22},
      tooltip:{trigger:"axis",formatter:p=>`${p[0].name}<br/>成交额 ${p[0].value}亿`},
      xAxis:{type:"category",data:S.map(s=>s.date.slice(5)),axisLabel:{color:"#8b949e",fontSize:10}},
      yAxis:{type:"value",axisLabel:{color:"#8b949e",fontSize:10,formatter:v=>(v/10000)+"万亿"},splitLine:{lineStyle:{color:"#21262d"}}},
      series:[{type:"bar",data:S.map((s,i)=>({value:s.yi,
        itemStyle:{color:i===S.length-1?"#e8b93e":(i>0&&s.yi>=S[i-1].yi?"#3d6fae":"#31517d")}})),
        barWidth:"62%",markLine:{silent:true,symbol:"none",
          lineStyle:{type:"dashed",color:"#8b949e"},label:{color:"#8b949e",fontSize:9,formatter:"5日均"},
          data:[{yAxis:(S.slice(0,-1).reduce((a,b)=>a+b.yi,0)/Math.max(1,S.length-1))}]}}]
    });
  }
})();

// ---------- ② 情绪周期：30日走势 + 表盘 + 实时指标 + 雷达
(function(){
  const sh = (D.sentiment_history||[]).slice(-30);
  const L = echarts.init(document.getElementById("sentLine"));
  L.setOption({
    tooltip:{ trigger:"axis" },
    grid:{ left:40, right:16, top:20, bottom:24 },
    xAxis:{ type:"category", data:sh.map(r=>r.date) },
    yAxis:{ type:"value", min:0, max:100, splitLine:{ lineStyle:{ color:"#21262d" } } },
    visualMap:{ show:false, min:0, max:100, dimension:1,
      pieces:[{gt:74,color:"#f85149"},{gt:61,lte:74,color:"#3fb950"},{gt:47,lte:61,color:"#d29922"},
              {gt:34,lte:47,color:"#8957e5"},{lte:34,color:"#58a6ff"}] },
    series:[{ type:"line", data:sh.map(r=>r.temp), symbol:"circle", symbolSize:4,
      markLine:{ silent:true, symbol:"none", lineStyle:{type:"dashed",color:"#30363d"},
        label:{ color:"#8b949e", fontSize:10, formatter:"{b}" },
        data:[{yAxis:34,name:"冰点34"},{yAxis:47,name:"退潮47"},{yAxis:61,name:"震荡61"},{yAxis:74,name:"偏强74"}] } }]
  });
  const g = echarts.init(document.getElementById("gauge"));
  g.setOption({
    series:[{ type:"gauge", min:0, max:100, splitNumber:5,
      axisLine:{ lineStyle:{ width:18, color:[[0.34,'#58a6ff'],[0.47,'#8957e5'],[0.61,'#d29922'],[0.74,'#3fb950'],[1,'#f85149']] } },
      pointer:{ itemStyle:{ color:"#c9d1d9" } },
      axisLabel:{ color:"#8b949e" },
      detail:{ formatter:'{value}', color:"#c9d1d9", fontSize:36, offsetCenter:[0,'65%'] },
      title:{ offsetCenter:[0,'95%'], color:"#8b949e", fontSize:12 },
      data:[{ value:D.sentiment.temperature, name:"情绪温度（0-100）" }] }]
  });
  // 实时指标条（盘后运行=收盘终值）
  const br = D.sentiment.breadth_rt||{};
  const ld = D.sentiment.leader_stock;
  const ratio = (br.rise!=null && br.fall!=null && br.fall>0) ? (br.rise/br.fall).toFixed(2) : "—";
  document.getElementById("sentRt").innerHTML =
    `<span class="rt-item">上涨 <b class="num-up">${br.rise??"—"}</b> : 下跌 <b class="num-down">${br.fall??"—"}</b>（比 <b>${ratio}</b>）</span>` +
    `<span class="rt-item">涨停 <b class="num-up">${br.limit_up??"—"}</b></span>` +
    `<span class="rt-item">跌停 <b class="num-down">${br.limit_down??"—"}</b></span>` +
    `<span class="rt-item">较前日 <b class="${pctCls(D.sentiment.delta)}">${D.sentiment.delta==null?"—":(D.sentiment.delta>0?"+":"")+D.sentiment.delta+"分"}</b></span>` +
    (ld?`<span class="rt-item">日级情绪龙头 <b>${esc(ld.name)}(${ld.code}) ${ld.lian_ban}连板</b></span>`:
        `<span class="rt-item">日级情绪龙头 <b>—</b></span>`);
  const r = echarts.init(document.getElementById("radar"));
  const f = D.sentiment.factors;
  r.setOption({
    radar:{ indicator:Object.keys(f).map(k=>({name:k, max:100})), radius:"65%",
      axisName:{ color:"#c9d1d9", fontSize:11 }, splitArea:{ areaStyle:{ color:["#161b22","#1c2129"] } } },
    series:[{ type:"radar", data:[{ value:Object.values(f), name:"今日六因子" }],
      areaStyle:{ opacity:0.3 } }]
  });
  const notes = D.sentiment.factor_notes||{};
  document.getElementById("zoneInfo").innerHTML =
    Object.entries(f).map(([k,v])=>`${k}：<b>${v}</b> <span class="factor-note">${esc(notes[k]||"")}</span>`).join("<br>") +
    `<br>基础温度 ${D.sentiment.base_temp} · 较前日 ${D.sentiment.delta==null?"—[数据缺失]":(D.sentiment.delta>0?"+":"")+D.sentiment.delta}`;
})();

// ---------- ③ 板块埋伏建议
(function(){
  const A = (D.sectors&&D.sectors.ambush)||{attack:[],defend:[],watch:""};
  let h = "";
  if((A.attack||[]).length){
    h += `<div class="rv-h" style="color:#f85149">进攻板块（偏强/高热期 · 埋伏低位补涨）</div>`;
    A.attack.forEach(a=>{ h += `<div class="dis-line" style="border-left-color:#f85149">
      <b>${esc(a.board)}</b>（#${a.rank}）— ${esc(a.basis)}<br>→ ${esc(a.action)}</div>`; });
  }
  if((A.defend||[]).length){
    h += `<div class="rv-h" style="color:#58a6ff">防守板块（冰点/退潮期 · 防守配置）</div>`;
    A.defend.forEach(a=>{ h += `<div class="dis-line" style="border-left-color:#58a6ff">
      <b>${esc(a.board)}</b>（#${a.rank}）— ${esc(a.basis)}<br>→ ${esc(a.action)}</div>`; });
  }
  if(!h && A.watch) h = `<div class="factor-note">${esc(A.watch)}</div>`;
  if(!h) h = "<div class='factor-note'>（当前情绪区间无进攻/防守标签板块）</div>";
  document.getElementById("ambush").innerHTML = h;
})();

// ---------- ③ 板块轮动榜（加列：当日涨幅/上涨广度/领涨股/主力净流入）
(function(){
  const dims = ["连板节奏","上攻意愿","主买占比","换手率","量能比","排名趋势"];
  const alias = D.board_alias_map||{};
  let h = "<tr><th>#</th><th>板块</th><th>总分</th><th>当日涨幅</th><th>上涨广度</th><th>领涨股</th><th>主力净流入</th>" +
          dims.map(d=>`<th>${d}</th>`).join("") + "<th>排名趋势</th><th>攻防</th></tr>";
  (D.sectors.boards||[]).forEach(b=>{
    const tag = b.tag==="进攻"?'<span class="tag tag-attack">进攻</span>':b.tag==="防御"?'<span class="tag tag-defend">防御</span>':"";
    const bname = alias[b.board] ? `${esc(b.board)}<span style="color:#e8b93e;font-size:11px">·${esc(alias[b.board])}</span>` : esc(b.board);
    h += `<tr><td>${b.rank}</td><td>${bname}</td><td><b>${b.total}</b></td>` +
      `<td class="${pctCls(b["当日涨幅"])}">${pct(b["当日涨幅"])}</td>` +
      `<td>${b.breadth==null?"—":b.breadth+"%"}<span class="factor-note">（${b.up_count??0}↑/${b.down_count??0}↓）</span></td>` +
      `<td>${esc(b.leader_stock||"—")}</td>` +
      `<td class="${pctCls(b.main_net_inflow_yi)}">${b.main_net_inflow_yi==null?"—":(b.main_net_inflow_yi>0?"+":"")+b.main_net_inflow_yi+"亿"}</td>` +
      dims.map(d=>`<td>${b.dims[d]==null?"—":b.dims[d]}</td>`).join("") +
      `<td>${b["排名趋势dir"]}</td><td>${tag}</td></tr>`;
  });
  document.getElementById("sectorTbl").innerHTML = h;
})();

// ---------- ④ 三线评分总揽
(function(){
  const PR = D.pool_review||{stats:{}};
  function statChip(pool, label){
    const s = (PR.stats||{})[pool]||{};
    const rr = s.win_rate==null?"—":s.win_rate+"%";
    const sr = s.spike_rate==null?"—":s.spike_rate+"%";
    return `<span class="pool-stat">次日收红率 ${rr}</span><span class="pool-stat">冲高率 ${sr}</span>` +
           `<span class="pool-stat">样本 ${s.samples??0}${(s.samples??0)<10?"（<10 不显示统计）":""}</span>`;
  }
  function poolTbl(rows, isShort){
    if(!rows || !rows.length) return "<div class='factor-note'>（空 · 宁缺毋滥）</div>";
    const alias = D.board_alias_map||{};
    let h = "<tr><th>代码</th><th>名称</th><th>板块</th><th>现价</th><th>涨幅</th><th>主力流入</th>" +
            "<th>换手率</th><th>乖离60</th><th>评分</th><th>次日收红率</th><th>冲高率</th><th>倾向</th>" +
            (isShort?"<th>S级/短线特征</th>":"<th>板块排名</th>") + "<th>建议动作</th></tr>";
    rows.forEach(r=>{
      const pb = r.prob||{};
      const bd = r.board ? (alias[r.board] ? `${esc(r.board)}<span style="color:#e8b93e;font-size:10px">·${esc(alias[r.board])}</span>` : esc(r.board)) : "—";
      h += `<tr><td>${r.code}</td><td>${esc(r.name)}</td><td>${bd}</td>
        <td>${r.price==null?"—":r.price}</td>
        <td class="${pctCls(r.pct_chg)}">${pct(r.pct_chg)}</td>
        <td class="${pctCls(r.main_net_pct)}">${r.main_net_pct==null?"—":pct(r.main_net_pct)}</td>
        <td>${r.turnover==null?"—":r.turnover+"%"}</td>
        <td class="${pctCls(r.bias60)}">${r.bias60==null?"—":r.bias60+"%"}</td>
        <td><b>${r.score??"—"}</b>${r.grade?` <span class="factor-note">${esc(r.grade)}</span>`:""}</td>
        <td class="${pb.red_rate==null?"":(pb.red_rate>=60?"num-up":pb.red_rate<=40?"num-down":"")}">${pb.red_rate==null?"—":pb.red_rate+"%"}</td>
        <td class="${pb.spike_rate==null?"":(pb.spike_rate>=40?"num-up":"")}">${pb.spike_rate==null?"—":pb.spike_rate+"%"}</td>
        <td>${esc(pb.tendency||"—")}<span class="pl">${pb.samples?`(n${pb.samples})`:""}</span></td>` +
        (isShort?`<td>${r.s_grade?`<span class="tag tag-s">S级</span> ${esc(r.s_reason||"")}`:
            (r.short_feat?`<span class="tag tag-attack">特征</span> ${esc(r.s_reason||"")}`:"—")}</td>`
                :`<td>${r.board_rank?("#"+r.board_rank):"—"}</td>`) +
        `<td>${esc(r.action||"—")}</td></tr>`;
    });
    return `<div class="tbl-wrap"><table>${h}</table></div>`;
  }
  const P = D.pools||{};
  document.getElementById("pools").innerHTML =
    `<div class="pool-h" style="color:#f85149;margin-top:0">短线候选池（S级冲高优先 + 短线特征 · 1-3天 · 破MA5删除）${statChip("短线")}</div>${poolTbl(P.短线,true)}` +
    `<div class="pool-h" style="color:#3fb950">中线候选池（主升确认 · 5-20天）${statChip("中线")}</div>${poolTbl(P.中线,false)}` +
    `<div class="pool-h" style="color:#58a6ff">长线候选池（观察区 · 20天+ · 等主升确认升级）${statChip("长线")}</div>${poolTbl(P.长线,false)}`;

  // ⑧ 三池Top3交叉验证精选（独立卡片）
  function jxTbl(rows){
    if(!rows || !rows.length) return "<div class='factor-note'>（今日无交叉验证精选）</div>";
    let h = "<tr><th>代码</th><th>名称</th><th>交叉源</th><th>命中数</th><th>评分</th><th>涨幅</th><th>次日收红率</th><th>建议动作</th></tr>";
    rows.forEach(r=>{
      const pb = r.prob||{};
      h += `<tr><td>${r.code}</td><td>${esc(r.name)}</td>
        <td>${esc(r.cross_src||"—")}</td><td><b>×${r.cross_n??1}</b></td>
        <td><b>${r.score??"—"}</b></td>
        <td class="${pctCls(r.pct_chg)}">${pct(r.pct_chg)}</td>
        <td class="${pb.red_rate==null?"":(pb.red_rate>=60?"num-up":"")}">${pb.red_rate==null?"—":pb.red_rate+"%"}</td>
        <td>${esc(r.action||"—")}</td></tr>`;
    });
    return `<div class="tbl-wrap"><table>${h}</table></div>`;
  }
  document.getElementById("jxTop").innerHTML = jxTbl(P.精选);
})();

// ---------- ④.5 双轨机会卡片
(function(){
  const EXEC = {"双轨":"#f85149","右轨主升跟随":"#3fb950","左轨预期差低吸":"#58a6ff","温和左侧布局":"#8957e5"};
  const cards = D.cards||[];
  if(!cards.length){ document.getElementById("oppCards").innerHTML =
    "<div class='factor-note'>（今日无符合双轨介入位的机会卡 · 东财封禁/降级期候选受限，解封后恢复）</div>"; return; }
  document.getElementById("oppCards").innerHTML = cards.map(c=>{
    const sigs=(c.signals||[]).map(s=>`<span class="tag" style="background:#1c2129">[${s.kind}]${esc(s.name)} ${esc(s.value||"")}</span>`).join("");
    const anchors=(c.anchors||{}); const aTxt=["估值"+((anchors.est_ok?"✓":"✗")||"✗"),"研报"+((anchors.forecast_ok?"✓":"✗")||"✗"),"产业"+((anchors.trend_ok?"✓":"✗")||"✗")].join(" ");
    return `<div class="rv-block" style="border:1px solid ${EXEC[c.exec_kind]||'#30363d'}44;border-radius:8px;padding:10px 12px">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <b>${esc(c.name)}</b><span class="wcode" style="font-size:11px;color:#8b949e">${c.code}</span>
        <span class="tag" style="background:#12283a;color:#7ec3ff">${esc(c.track)}</span>
        <span style="color:${EXEC[c.exec_kind]||'#d29922'};font-weight:600">${esc(c.exec_kind)}</span>
        <span class="factor-note">介入：${esc(c.exec_sig)}</span></div>
      <div style="font-size:12px;color:#9db4d6;margin:6px 0">${sigs||'<span class="factor-note">无稳定异动（仅观察）</span>'}</div>
      <div style="font-size:11.5px;color:#8b949e">${aTxt} &nbsp; ${esc((c.evidence||[]).join(" · "))}</div>
      ${c.wave&&c.wave.passes?`<div style="font-size:11.5px;color:#3fb950">右轨门槛过：${Object.entries(c.wave.gates||{}).filter(([_,v])=>v).map(([k])=>k).join("+")} · 主升${c.wave.score}分</div>`:""}
      <div style="font-size:12px;color:#8fd8b4;margin-top:5px;border-top:1px dashed #21262d;padding-top:4px">${esc(c.thesis)}</div>
      <div style="font-size:11.5px;color:#c8b48a">放弃条件：${esc(c.risk_off)}</div>
    </div>`;
  }).join("");
})();

// ---------- ⑤ 观察池复盘
(function(){
  const PR = D.pool_review||{stats:{},yesterday:{},active:{},removed:[]};
  function statsLine(pool){
    const s = (PR.stats||{})[pool]||{};
    const v = x => x==null?"—":(x>0?"+":"")+Number(x).toFixed(2)+"%";
    return `次日胜率 <b class="${s.win_rate==null?"":(s.win_rate>=50?"num-up":"num-down")}">${s.win_rate==null?"—":s.win_rate+"%"}</b>` +
      `（样本${s.samples??0}${(s.samples??0)<10?"，<10不统计":""}） · 平均开盘 <b class="${pctCls(s.avg_open_ret)}">${v(s.avg_open_ret)}</b>` +
      ` · 平均收盘 <b class="${pctCls(s.avg_close_ret)}">${v(s.avg_close_ret)}</b>` +
      ` · 平均最高收益 <b class="${s.avg_high_ret==null?"":(s.avg_high_ret>=0?"num-up":"num-down")}">${v(s.avg_high_ret)}</b>（冲高可兑现空间）`;
  }
  function reviewTbl(rows){
    if(!rows || !rows.length) return "<div class='factor-note'>（空）</div>";
    let h = "<tr><th>股票</th><th>入选时间</th><th>评分</th><th>入选价</th><th>次日开盘</th><th>次日最高</th><th>次日收盘</th>" +
            "<th>开盘收益</th><th>最高收益</th><th>状态总结</th><th>老樊模型</th><th>入选原因</th></tr>";
    rows.forEach(r=>{
      const nd = r.next_day;
      h += `<tr><td><b>${esc(r.name||"—")}</b> <span style="font-size:11px;color:#8b949e">${r.code}</span></td>
        <td>${esc(r.added_date||"—")}</td><td>${r.score??"—"}</td><td>${r.add_price??"—"}</td>` +
        `<td>${nd?nd.open:"—"}</td><td>${nd?nd.high:"—"}</td><td>${nd?nd.close:"—"}</td>` +
        `<td class="${nd?pctCls(nd.open_ret):""}">${nd?pct(nd.open_ret):"—"}</td>` +
        `<td class="${nd?pctCls(nd.high_ret):""}">${nd?pct(nd.high_ret):"—"}</td>` +
        `<td>${esc(r.status_summary||"—")}</td><td>${esc(r.model||"—")}</td><td>${esc(r.reason||"—")}</td></tr>`;
    });
    return `<div class="tbl-wrap"><table>${h}</table></div>`;
  }
  const names = {"短线":"短线观察池（破5日线删除）","中线":"中线观察池（评分<60 或 破MA20 删除）","长线":"长线观察池（破中期带下沿删除）"};
  function renderPools(pools){
    let h = "";
    pools.forEach(p=>{
      h += `<div class="rv-block"><div class="pool-h" style="margin-top:0">${names[p]}</div>
        <div class="rv-stats">${statsLine(p)}</div>`;
      const yd = (PR.yesterday||{})[p]||[];
      h += `<div class="rv-h">上一交易日（${esc(PR.yesterday_date||"—")}）本池评分前五：</div>${reviewTbl(yd)}`;
      const act = (PR.active||{})[p]||[];
      h += `<div class="rv-h">当前在池（去弱留强 · 共${act.length}条）：</div>${reviewTbl(act)}</div>`;
    });
    if((PR.removed||[]).length){
      h += `<div class="rv-h">今日删除日志：</div>` +
        PR.removed.map(m=>`<div class="dis-line">${esc(m)}</div>`).join("");
    }
    return h;
  }
  document.getElementById("poolReview").innerHTML = renderPools(["短线"]);
  document.getElementById("poolReview2").innerHTML = renderPools(["中线","长线"]);
})();

// ---------- ⑥ 打板筛选
(function(){
  document.getElementById("limitupDiscipline").innerHTML =
    (D.limitup_discipline||[]).map(l=>`<div class="dis-line">${esc(l)}</div>`).join("");
  const rows = (D.pools&&D.pools.打板)||[];
  if(!rows.length){ document.getElementById("limitup").innerHTML =
    "<div class='factor-note'>（今日无符合条件标的 · 一字/炸板/资金流出/极端换手已排除）</div>"; return; }
  const alias2 = D.board_alias_map||{};
  let h = "<tr><th>代码</th><th>名称</th><th>板位</th><th>封板时间</th><th>开板</th><th>量比</th><th>换手率</th>" +
          "<th>主力净额</th><th>近5日涨幅</th><th>板块（共振）</th><th>打板评分</th><th>建议</th><th>次日执行提示</th></tr>";
  rows.forEach(r=>{
    const bd = r.board ? (alias2[r.board] ? `${esc(r.board)}<span style="color:#e8b93e;font-size:10px">·${esc(alias2[r.board])}</span>` : esc(r.board)) : "—";
    h += `<tr><td>${r.code}</td><td>${esc(r.name)}</td><td><b>${r.lian_ban??"—"}板</b></td>
      <td>${esc(r.first_seal_time||"—")}</td><td>${r.open_times??0}次</td>
      <td>${r.vr==null?"—":r.vr}</td><td>${r.turnover==null?"—":r.turnover+"%"}</td>
      <td class="${pctCls(r.main_net_pct)}">${r.main_net_pct==null?"—":pct(r.main_net_pct)}</td>
      <td class="${pctCls(r.pct5)}">${pct(r.pct5)}</td>
      <td>${bd}<span class="factor-note">（${r.board_zt_count??0}涨停/梯队${r.board_ladder??0}档）</span></td>
      <td><b>${r.score??"—"}</b></td><td>${esc(r.action||"—")}</td>
      <td><span class="factor-note">${esc(r.next_exec||"—")}</span></td></tr>`;
  });
  document.getElementById("limitup").innerHTML = `<div class="tbl-wrap"><table>${h}</table></div>`;
})();

// ---------- ⑦⑧ 持仓卡片 + K线双带 + 信号日历
const sigRows = [];
function renderPosition(idx, p, isHolding){
  const div = document.createElement("div");
  div.className = "card";
  const st = p.state_cn||"空仓";
  div.innerHTML = `<div class="pos-head">
    <b style="font-size:15px">${esc(p.name)} ${p.code}</b>
    <span class="state-pill st-${p.state||"EMPTY"}">${st}</span>
    <span>仓位 ${p.position_pct??0}%</span>
    ${p.cost?`<span>成本 ${p.cost} · 盈亏 <span class="${pctCls(p.pnl_pct)}">${pct(p.pnl_pct)}</span></span>`:""}
    <span>BIAS60 <b>${p.bias60==null?"—":p.bias60+"%"}</b>（${esc(p.bias_zone||"—")}）</span>
    <span>${esc(p.trend_cn||"")}</span>
    <span>距中期带上沿 ${p.dist_mid_upper==null?"—":(p.dist_mid_upper>0?"+":"")+p.dist_mid_upper+"%"}</span>
  </div><div id="k${idx}" class="chart-sm"></div>
  <div style="font-size:12px;margin:6px 0">当前信号：${
    (p.signals&&p.signals.length)?p.signals.map(s=>`<span class="sig-${s.type[0]==='B'?'BP':'SP'}">${s.type} ${esc(s.name)}（置信${s.confidence}%，${esc(s.position_action)}）</span>`).join(" · "):"<span class='factor-note'>无</span>"}
  </div>
  ${(p.sell_alerts&&p.sell_alerts.length)?`<div style="font-size:12px;margin:6px 0">卖出监控：${
    p.sell_alerts.map(a=>`<span class="${a.priority.toLowerCase()}">[${a.priority}|${a.source}|${esc(a.signal)}] ${esc(a.name)} → ${esc(a.action)}</span>`).join("<br>")}</div>`:""}
  ${p.t0?`<div style="font-size:12px;margin:6px 0">T0协同：${esc(p.t0.action)}（置信${p.t0.confidence}%）— ${esc(p.t0.note)}</div>`:""}
  <pre class="advice">${esc(p.advice||"")}</pre>`;
  document.getElementById("positions").appendChild(div);

  // K线 + 双带 + BIAS60 副图
  const kl = p.kline;
  if(!kl || !kl.dates || !kl.dates.length) return;
  const chart = echarts.init(document.getElementById("k"+idx));
  const N = kl.dates.length;
  const maSeries = Object.entries(kl.ma||{}).map(([k,v])=>({
    name:k, type:"line", data:v, symbol:"none",
    lineStyle:{ width: /5|8|13/.test(k)?1.2:1.6, opacity:.9 },
    itemStyle:{ color: /5|8|13/.test(k)? "#e0913f":"#58a6ff" },
    emphasis:{ disabled:true }
  }));
  const band = (b,color,stack)=>{
    const lower = (b.lower||[]).map(x=>x==null?null:+(+x).toFixed(3));
    const upper = (b.upper||[]).map(x=>x==null?null:+(+x).toFixed(3));
    const span = lower.map((x,i)=> (x==null||upper[i]==null)?null:+(upper[i]-x).toFixed(3));
    return [
      { name:"带下沿"+stack, type:"line", data:lower, stack:stack, symbol:"none",
        lineStyle:{opacity:0}, emphasis:{ disabled:true }, silent:true },
      { name:"带上沿"+stack, type:"line", data:span, stack:stack, symbol:"none",
        lineStyle:{opacity:0}, areaStyle:{color:color}, emphasis:{ disabled:true }, silent:true }
    ];
  };
  const marks = (p.signal_marks||[]).map(m=>({
    coord:[m.date, m.price], value:m.name, symbol:"pin", symbolSize:38,
    itemStyle:{ color: m.type[0]==="B"?"#3fb950":"#f85149" },
    label:{ color:"#fff", fontSize:10 }
  }));
  chart.setOption({
    tooltip:{ trigger:"axis", axisPointer:{type:"cross"} },
    legend:{ data:["MA5","MA8","MA13","MA55","MA60","MA65"], textStyle:{color:"#8b949e",fontSize:10}, top:0 },
    grid:[{left:56,right:16,top:26,height:"55%"},{left:56,right:16,top:"72%",height:"20%"}],
    xAxis:[{type:"category",data:kl.dates,gridIndex:0},
           {type:"category",data:kl.dates,gridIndex:1,axisLabel:{show:false}}],
    yAxis:[{scale:true,gridIndex:0,splitLine:{lineStyle:{color:"#21262d"}}},
           {gridIndex:1,splitLine:{lineStyle:{color:"#21262d"}},
            axisLabel:{formatter:v=>v+"%"}}],
    dataZoom:[{type:"inside",xAxisIndex:[0,1],start:Math.max(0,100-120/N*100),end:100}],
    series:[
      { name:"K线", type:"candlestick", data:kl.k.map(x=>[x[0],x[1],x[2],x[3]]),
        itemStyle:{ color:"#f85149", color0:"#3fb950", borderColor:"#f85149", borderColor0:"#3fb950" },
        markPoint:{ data:marks } },
      ...band(kl.short_band,"rgba(224,145,63,0.12)","s1"),
      ...band(kl.mid_band,"rgba(88,166,255,0.15)","m1"),
      ...maSeries,
      { name:"BIAS60", type:"line", data:(kl.bias60||[]).map(x=>x==null?null:+(+x).toFixed(2)),
        xAxisIndex:1, yAxisIndex:1, symbol:"none", lineStyle:{color:"#d29922",width:1.2},
        markLine:{ silent:true, symbol:"none", lineStyle:{type:"dashed",color:"#8b949e"},
          label:{formatter:"{c}%"}, data:[{yAxis:25},{yAxis:-25}] } }
    ]
  });
}
(D.positions||[]).forEach((p,i)=>{
  renderPosition(i,p,true);
  (p.signal_marks||[]).forEach(m=>sigRows.push({date:m.date,code:p.code,name:p.name,type:m.type,price:m.price}));
  (p.signals||[]).forEach(s=>{
    if(s.is_today) sigRows.unshift({date:D.date,code:p.code,name:p.name,type:s.type,price:p.price});
  });
});
sigRows.sort((a,b)=>a.date<b.date?1:-1);
(function(){
  const rows = sigRows.slice(0,20);
  let h = "<tr><th>日期</th><th>代码</th><th>名称</th><th>信号</th><th>价格</th></tr>";
  rows.forEach(r=>{ h += `<tr><td>${r.date}</td><td>${r.code}</td><td>${esc(r.name)}</td>
    <td class="${r.type[0]==='B'?'sig-BP':'sig-SP'}">${r.type}</td><td>${r.price??"—"}</td></tr>`; });
  document.getElementById("sigTbl").innerHTML = h || "<tr><td>近20日无信号记录</td></tr>";
})();

// ---------- ⑨ 风险提示
(function(){
  const R = D.risks||{};
  let h = "";
  (R.missing||[]).forEach(m=>h+=`<div class="risk-item">[数据缺失] ${esc(m)}</div>`);
  (R.cooldown||[]).forEach(m=>h+=`<div class="risk-item">[冷却期/拦截] ${esc(m)}</div>`);
  (R.discipline||[]).forEach(m=>h+=`<div class="risk-item">[纪律] ${esc(m)}</div>`);
  if(!h) h = "<div class='factor-note'>今日无数据缺失与拦截提示</div>";
  document.getElementById("risks").innerHTML = h;
})();
window.addEventListener("resize",()=>{document.querySelectorAll(".chart,.chart-sm").forEach(el=>{
  const c=echarts.getInstanceByDom(el); if(c)c.resize();});});
</script>
</body>
</html>
